# バックエンド API のベース URL。末尾スラッシュなし。
# 例: https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com
VITE_API_BASE_URL=http://localhost:3000

# Amazon Cognito User Pool ID。infra の CDK スタック `Household-<stage>-Auth` の
# CfnOutput（UserPoolId）から取得する。
# 例: ap-northeast-1_xxxxxxxxx
VITE_COGNITO_USER_POOL_ID=

# Amazon Cognito User Pool のアプリクライアント ID。同じく `Household-<stage>-Auth`
# スタックの CfnOutput（UserPoolClientId）から取得する。
VITE_COGNITO_CLIENT_ID=
